node_modules
dist
dist-ssr
*.local
.DS_Store
.vite

# QA screenshots of the local build. Verification artifacts, not source —
# they go stale the moment a page changes and would bloat the repo.
qa-screenshots/

# Client context, pricing, and scoping documents. These live in the repo folder
# for convenience but must never be committed.
clients/
*context*.xml
*context*.md

# Raw asset drops from Ray or from a park visit. Camera-original HEIC at ~3MB
# each; the whole in_person_images zip is 219MB. Convert what you need into
# src/assets and leave the originals out of git — the repo is not the archive.
*.zip
src/assets/**/*.heic
src/assets/**/*.HEIC
